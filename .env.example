# Server-only admin gate. Set in the host (e.g. Vercel env), never commit a real value.
# Login compares against this secret; no password is stored in the repo or client bundle.
BOMKONG_ADMIN_SECRET=

# Optional override for home menu tile 6 YouTube channel URL.
# Default in app/page.tsx: https://www.youtube.com/@봄이콩이BomKong
# NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@%EB%B4%84%EC%9D%B4%EC%BD%A9%EC%9D%B4BomKong

# YouTube Data API v3 — Shorts upload from 미공개 영상실 (server-only).
# Leave blank until Harry fills real values in Vercel. Never commit secrets.
# Setup checklist: docs/youtube-shorts-setup.md
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Must match Google Cloud OAuth client "Authorized redirect URI"
# Example: https://your-domain.vercel.app/api/admin/youtube/oauth/callback
YOUTUBE_REDIRECT_URI=
